# The NetBox image (platform ADR 0035): netbox-docker 5.1.1 with NetBox
# v4.7.4, the newest of each on 2026-11-01. Read by the orchestrator's fetch
# command and by install-netbox.sh. A move of the pin changes all four lines,
# read from the registry, and nothing else.
#
# The image index, which the orchestrator pulls by this digest.
NETBOX_IMAGE=ghcr.io/netbox-community/netbox:v4.7.4-5.1.1
NETBOX_INDEX_DIGEST=sha256:69cd72d0b0e4928a90940a7011954aaa7060c75fddd8dc6cea2f19407bae45b1
# The index's linux/amd64 manifest, and the digest of that manifest's config,
# which is the ID Podman gives the image. The target compares the image it
# loaded with this ID, because a load does not keep the registry's digests.
NETBOX_MANIFEST_DIGEST=sha256:6fc8e4f0ae55dffadb44cc12f82b806389e99befe6e536ef6650de55e171b4e7
NETBOX_IMAGE_ID=sha256:9f5bc18eafba85c64dcda8243007a8bc29377382b1ae3643e6e52e52b46b6193
