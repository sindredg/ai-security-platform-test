# NetBox's settings that are not secret, read by netbox-docker's configuration
# (platform ADR 0035). The secrets are files under /run/secrets.
DB_HOST=127.0.0.1
DB_NAME=netbox
DB_USER=netbox
REDIS_HOST=127.0.0.1
REDIS_DATABASE=0
REDIS_CACHE_DATABASE=1
# The names a client may ask for. The configuration adds localhost.
ALLOWED_HOSTS=10.50.0.4 netbox.aisec.internal
# The administrator is made when the inventory is seeded, not at start.
SKIP_SUPERUSER=true
# NetBox reports its use to a census server by default. The VM reaches
# nothing, so each report could only fail.
CENSUS_REPORTING_ENABLED=false
# Granian reads its options from GRANIAN_ variables (platform ADR 0038).
GRANIAN_PORT=8443
GRANIAN_WORKERS=2
GRANIAN_SSL_CERTIFICATE=/etc/netbox/tls.crt
GRANIAN_SSL_KEYFILE=/run/secrets/tls.key
